<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DeVinci" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/soft_gold</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/royal_purple</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/card_background</item>
    </style>

    <style name="Theme.DeVinci.NoActionBar" parent="Theme.DeVinci">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerSize">20%</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerSize">50%</item>
    </style>
</resources>
